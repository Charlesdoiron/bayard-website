# --- Site ---
NEXT_PUBLIC_SITE_URL=https://club-bayard.fr

# --- Newsletter (existant) ---
BREVO_API_KEY=
BREVO_LIST_ID=4

# --- Boutique : Supabase ---
# Sans ces deux variables, la boutique tourne en mode démonstration (données fictives, pas de comptes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service (serveur uniquement) : emails vers les vendeurs, cron d'expiration, suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# --- Boutique : emails transactionnels (Brevo) ---
BOUTIQUE_EMAIL_FROM=boutique@clubbayard.com
BOUTIQUE_EMAIL_FROM_NAME=Boutique Club Bayard
# Destinataires des notifications administrateur (séparés par des virgules)
BOUTIQUE_ADMIN_EMAILS=secretariat@clubbayard.com

# --- Boutique : cron d'expiration (GET /api/boutique/cron avec l'en-tête Authorization: Bearer <secret>) ---
BOUTIQUE_CRON_SECRET=
